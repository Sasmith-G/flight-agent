# Execution mode: "mock" runs the full pipeline with recorded API fixtures (no keys needed).
# "live" calls the Amadeus test environment and the Anthropic API.
AGENT_MODE=mock

# Amadeus for Developers (https://developers.amadeus.com) — free Self-Service test keys
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Anthropic — used to draft the passenger recommendation
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: Twilio WhatsApp/SMS notification (console notifier is used when unset)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
